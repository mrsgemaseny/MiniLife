{
  "context-loader": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/pre-invocation.ps1",
        "timeout": 15
      }
    ]
  },
  "safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/safety-gate.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enforce-workflow": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/enforce-workflow.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "stop-commit-check": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-check-commits.ps1",
        "timeout": 15
      }
    ]
  }
}


