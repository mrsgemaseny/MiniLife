[gd_scene load_steps=3 format=3]

[sub_resource type="GDScript" id="GDScript_bed"]
script/source = "extends StaticBody2D

func _ready() -> void:
	add_to_group(\"interactable\")

func interact(actor: Node) -> void:
	if actor != null:
		var stats: StatsComponent = actor.get(\"stats\") as StatsComponent
		if stats != null:
			stats.modify(\"health\", 25.0)
			stats.modify(\"stamina\", 100.0)
	SignalBus.notification_posted.emit(\"Rested at bed.\")
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_bed"]
size = Vector2(48, 26)

[node name="Bed" type="StaticBody2D" groups=["interactable"]]
y_sort_enabled = true
script = SubResource("GDScript_bed")

[node name="Sprite2D" type="Sprite2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_bed")
