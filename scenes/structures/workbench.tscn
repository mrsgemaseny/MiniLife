[gd_scene load_steps=3 format=3]

[sub_resource type="GDScript" id="GDScript_workbench"]
script/source = "extends StaticBody2D

func _ready() -> void:
	add_to_group(\"interactable\")
	add_to_group(\"craft_station\")

func get_station_id() -> String:
	return \"workbench\"

func interact(_actor: Node) -> void:
	SignalBus.craft_station_opened.emit(\"workbench\")
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_wb"]
size = Vector2(44, 24)

[node name="Workbench" type="StaticBody2D" groups=["interactable", "craft_station"]]
y_sort_enabled = true
script = SubResource("GDScript_workbench")

[node name="Sprite2D" type="Sprite2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_wb")
