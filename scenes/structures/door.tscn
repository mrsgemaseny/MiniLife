[gd_scene load_steps=3 format=3]

[sub_resource type="GDScript" id="GDScript_door"]
script/source = "extends StaticBody2D

var _open: bool = false
@onready var collision_shape: CollisionShape2D = $CollisionShape2D

func _ready() -> void:
	add_to_group(\"interactable\")

func interact(_actor: Node) -> void:
	_open = not _open
	if collision_shape != null:
		collision_shape.set_deferred(\"disabled\", _open)
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_door"]
size = Vector2(48, 24)

[node name="Door" type="StaticBody2D" groups=["interactable"]]
y_sort_enabled = true
script = SubResource("GDScript_door")

[node name="Sprite2D" type="Sprite2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("RectangleShape2D_door")
