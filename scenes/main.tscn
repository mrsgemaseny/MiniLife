[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node2D

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	if SaveSystem.slot_exists(Config.DEFAULT_SAVE_SLOT):
		SignalBus.load_requested.emit(Config.DEFAULT_SAVE_SLOT)
	else:
		GameManager.start_new_game(randi(), Config.DEFAULT_SAVE_SLOT)

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_inventory\"):
		SignalBus.ui_panel_requested.emit(\"inventory\")
	elif event.is_action_pressed(\"ui_craft\"):
		SignalBus.ui_panel_requested.emit(\"craft\")
	elif event.is_action_pressed(\"ui_build\"):
		SignalBus.ui_panel_requested.emit(\"build\")
	elif event.is_action_pressed(\"ui_quests\"):
		SignalBus.ui_panel_requested.emit(\"quests\")
	elif event.is_action_pressed(\"ui_character\"):
		SignalBus.ui_panel_requested.emit(\"character\")
	elif event.is_action_pressed(\"ui_achievements\"):
		SignalBus.ui_panel_requested.emit(\"achievements\")
	elif event.is_action_pressed(\"ui_close\"):
		SignalBus.ui_close_all_requested.emit()
	elif event.is_action_pressed(\"quick_save\"):
		SignalBus.save_requested.emit(GameManager.get_active_slot())
	elif event.is_action_pressed(\"quick_load\"):
		SignalBus.load_requested.emit(GameManager.get_active_slot())
	elif event.is_action_pressed(\"debug_god\"):
		GameManager.debug_god_mode = not GameManager.debug_god_mode
	elif event.is_action_pressed(\"debug_fast_time\"):
		GameManager.debug_fast_time = not GameManager.debug_fast_time
	elif event.is_action_pressed(\"debug_reveal\"):
		GameManager.debug_reveal_map = not GameManager.debug_reveal_map
"

