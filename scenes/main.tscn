[sub_resource type="GDScript" id="GDScript_main"]
script/source = "extends Node2D

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_setup_dynamic_systems()
	GameManager.start_new_game(Config.DEFAULT_WORLD_SEED, Config.DEFAULT_SAVE_SLOT)

func _setup_dynamic_systems() -> void:
	var systems: Node = get_node_or_null(\"Systems\")
	if systems != null:
		if systems.get_node_or_null(\"ResearchSystem\") == null:
			var r_sys: Node = Node.new()
			r_sys.name = \"ResearchSystem\"
			r_sys.set_script(load(\"res://scripts/systems/research_system.gd\"))
			systems.add_child(r_sys)
		if systems.get_node_or_null(\"FurnaceSystem\") == null:
			var f_sys: Node = Node.new()
			f_sys.name = \"FurnaceSystem\"
			f_sys.set_script(load(\"res://scripts/systems/crafting/furnace_system.gd\"))
			systems.add_child(f_sys)

	var ui_layer: CanvasLayer = get_node_or_null(\"UILayer\") as CanvasLayer
	if ui_layer != null:
		if ui_layer.get_node_or_null(\"ChestLoot\") == null:
			var cl: Control = Control.new()
			cl.name = \"ChestLoot\"
			cl.set_script(load(\"res://scripts/ui/chest_loot_ui.gd\"))
			ui_layer.add_child(cl)
		if ui_layer.get_node_or_null(\"FurnaceUI\") == null:
			var fu: Control = Control.new()
			fu.name = \"FurnaceUI\"
			fu.set_script(load(\"res://scripts/ui/furnace_ui.gd\"))
			ui_layer.add_child(fu)
		if ui_layer.get_node_or_null(\"ResearchTreeUI\") == null:
			var rt: Control = Control.new()
			rt.name = \"ResearchTreeUI\"
			rt.set_script(load(\"res://scripts/ui/research_tree_ui.gd\"))
			ui_layer.add_child(rt)

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventKey and event.pressed and not event.echo:
		var k: InputEventKey = event as InputEventKey
		if k.keycode == KEY_F11 or (k.keycode == KEY_ENTER and k.alt_pressed):
			var cur_mode: int = DisplayServer.window_get_mode()
			if cur_mode == DisplayServer.WINDOW_MODE_FULLSCREEN or cur_mode == DisplayServer.WINDOW_MODE_EXCLUSIVE_FULLSCREEN:
				DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_MAXIMIZED)
			else:
				DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
			return
	if event.is_action_pressed(\"ui_inventory\"):
		SignalBus.ui_panel_requested.emit(\"inventory\")
	elif event.is_action_pressed(\"ui_craft\"):
		SignalBus.ui_panel_requested.emit(\"craft\")
	elif event.is_action_pressed(\"ui_build\") or (event is InputEventKey and event.pressed and not event.echo and (event as InputEventKey).keycode == KEY_B):
		var bsys: BuildingSystem = get_node_or_null(\"BuildingSystem\") as BuildingSystem
		if bsys != null and bsys.is_build_mode_active():
			bsys.set_build_mode(\"\")
			get_viewport().set_input_as_handled()
			return
		SignalBus.ui_panel_requested.emit(\"build\")
	elif event.is_action_pressed(\"ui_quests\"):
		SignalBus.ui_panel_requested.emit(\"quests\")
	elif event.is_action_pressed(\"ui_character\"):
		SignalBus.ui_panel_requested.emit(\"character\")
	elif event.is_action_pressed(\"ui_factions\"):
		SignalBus.ui_panel_requested.emit(\"factions\")
	elif event.is_action_pressed(\"ui_chronicle\"):
		SignalBus.ui_panel_requested.emit(\"chronicle\")
	elif event.is_action_pressed(\"ui_achievements\"):
		SignalBus.ui_panel_requested.emit(\"achievements\")
	elif event.is_action_pressed(\"ui_close\"):
		SignalBus.ui_close_all_requested.emit()
	elif event.is_action_pressed(\"quick_save\"):
		SignalBus.save_requested.emit(GameManager.get_active_slot())
	elif event.is_action_pressed(\"quick_load\"):
		SignalBus.load_requested.emit(GameManager.get_active_slot())
	elif event.is_action_pressed(\"debug_god\"):
		GameManager.debug_god_mode = not GameManager.debug_god_mode
	elif event.is_action_pressed(\"debug_fast_time\"):
		GameManager.debug_fast_time = not GameManager.debug_fast_time
	elif event.is_action_pressed(\"debug_reveal\"):
		GameManager.debug_reveal_map = not GameManager.debug_reveal_map
"

