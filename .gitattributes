# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Godot source and scenes (always LF)
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf

# PowerShell scripts (CRLF on Windows)
*.ps1 text eol=crlf

# Binary asset formats
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text eol=lf
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.blend binary
